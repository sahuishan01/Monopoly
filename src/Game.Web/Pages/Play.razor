@page "/play/{Code}"
@implements IDisposable
@inject Session Session
@inject NavigationManager Nav
@inject IJSRuntime Js

<main class="play">
  @if (game?.Display != null && game.Board != null)
  {
    <div class="stage">
      <button class="ghost" @onclick="ToggleView">@(use3d ? "2D" : "3D")</button>
      @if (use3d) { <Board3D Game="game" OnUnavailable="Fallback" OnTileClick="OnTile" /> }
      else { <Board2D State="game.Display" Board="game.Board" Game="game" OnTileClick="OnTile" /> }
    </div>
    <div class="side">
      <Hud Game="game" />
      @if (selected is int sel)
      {
        <PropertyPanel Game="game" Tile="sel" />
      }
      <TradeDialog Game="game" />
      <AudioBridge Game="game" />
    </div>
  }
  else if (game?.UpdateRequired != null) { <p class="error" role="alert">This version is out of date. Please refresh.</p> }
  else if (error != null) { <p class="error" role="alert">@error</p> }
  else { <p>Loading match…</p> }
</main>

@code {
    [Parameter] public string Code { get; set; } = "";
    private GameSession? game;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (Session.Auth == null) { Nav.NavigateTo("/"); return; }
        Detach();
        game = null;
        error = null;
        try
        {
            game = await GameLoop.OpenAsync(Session, Nav, Code);
            error = null;
        }
        catch (Exception e) when (e is HttpRequestException or System.Net.WebSockets.WebSocketException or InvalidOperationException or JSException)
        {
            if (Session.Game?.UpdateRequired != null) { game = Session.Game; error = null; }
            else { error = "Could not join this match."; return; }
        }
        game.Changed += OnChanged;
        game.Client.ReturnedToLobby += BackToLobby;
    }

    private void Detach()
    {
        if (game == null) return;
        game.Changed -= OnChanged;
        game.Client.ReturnedToLobby -= BackToLobby;
    }

    private void BackToLobby() => InvokeAsync(() => Nav.NavigateTo("/room/" + Code));
    private void OnChanged() => InvokeAsync(StateHasChanged);
    private int? selected;
    private bool use3d;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (await Js.InvokeAsync<string?>("localStorage.getItem", "view3d") == "1") { use3d = true; StateHasChanged(); }
        }
        catch { }
    }

    private async Task ToggleView()
    {
        use3d = !use3d;
        try { await Js.InvokeVoidAsync("localStorage.setItem", "view3d", use3d ? "1" : "0"); } catch { }
    }

    private Task Fallback() { use3d = false; return InvokeAsync(StateHasChanged); }
    private Task OnTile(int tile) { selected = tile; return Task.CompletedTask; }

    public void Dispose() => Detach();
}
