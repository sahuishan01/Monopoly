@page "/"
@inject Session Session
@inject NavigationManager Nav

<main class="home">
  <header class="hero">
    <h1>BoardEmpire</h1>
    <p>Build, trade and bankrupt your friends — right in the browser.</p>
  </header>
  @if (error != null) { <p class="error" role="alert">@error</p> }

  <section class="card">
    <label class="field">Your name
      <input @bind="name" maxlength="20" placeholder="Guest" />
    </label>
  </section>

  <section class="card primary">
    <h2>Play vs bots</h2>
    <p class="hint">Start instantly against computer players.</p>
    <div class="row wrap">
      <label class="field">Bots
        <select @bind="botCount">
          @for (int i = 1; i <= 5; i++) { <option value="@i">@i</option> }
        </select>
      </label>
      <label class="field">Level
        <select @bind="botLevel">
          @foreach (var l in Enum.GetNames<BotLevel>()) { <option value="@l">@l</option> }
        </select>
      </label>
      <button disabled="@busy" @onclick="PlayBots">Play vs bots</button>
    </div>
  </section>

  <section class="card">
    <h2>Play online</h2>
    <p class="hint">Find a game or invite friends with a room code.</p>
    <div class="row">
      <button disabled="@busy" @onclick="Quick">Quick match</button>
      <button class="ghost" disabled="@busy" @onclick="Create">Create room</button>
    </div>
    <div class="row">
      <input @bind="joinCode" maxlength="8" placeholder="Room code" style="flex:1" />
      <button class="ghost" disabled="@busy" @onclick="Join">Join</button>
    </div>
  </section>

  <section class="card">
    <h2>Open rooms <button class="ghost" style="float:right;padding:.2rem .6rem" @onclick="Refresh">Refresh</button></h2>
    @if (rooms.Count == 0) { <p class="hint">No open rooms. Create one!</p> }
    <ul>
      @foreach (var r in rooms)
      {
        <li><span>@r.Name — @r.Players/@r.MaxPlayers — @r.Preset</span>
            <button @onclick="() => GoTo(r.Code)">Join</button></li>
      }
    </ul>
  </section>
</main>

@code {
    private string name = "";
    private string joinCode = "";
    private string? error;
    private bool busy;
    private IReadOnlyList<RoomSummary> rooms = Array.Empty<RoomSummary>();

    protected override Task OnInitializedAsync() => Refresh();

    private async Task Refresh()
    {
        try { rooms = await Session.Api.RoomsAsync(); }
        catch (ApiException e) { error = e.Message; }
        catch (HttpRequestException) { error = "Can't reach the server."; }
    }

    private async Task Run(Func<Task> action)
    {
        busy = true;
        error = null;
        try { await action(); }
        catch (ApiException e) { error = e.Message; }
        catch (HttpRequestException) { error = "Can't reach the server."; }
        finally { busy = false; }
    }

    private Task Quick() => Run(async () =>
    {
        await Session.EnsureGuestAsync(Clean());
        string code = await Session.Api.QuickMatchAsync("quick");
        Nav.NavigateTo("/room/" + code);
    });

    private Task Create() => Run(async () =>
    {
        var auth = await Session.EnsureGuestAsync(Clean());
        string code = await Session.Api.CreateRoomAsync(auth.DisplayName + "'s game", "classic", "", 6, true);
        Nav.NavigateTo("/room/" + code);
    });

    private int botCount = 3;
    private string botLevel = nameof(BotLevel.Medium);

    private Task PlayBots() => Run(async () =>
    {
        var auth = await Session.EnsureGuestAsync(Clean());
        string code = await Session.Api.CreateRoomAsync(auth.DisplayName + "'s game", "classic", "", botCount + 1, false);
        Nav.NavigateTo($"/room/{code}?bots={botCount}&level={botLevel}");
    });

    private Task Join() => Run(async () =>
    {
        string code = joinCode.Trim().ToUpperInvariant();
        if (code.Length == 0) { error = "Enter a room code."; return; }
        if (!await Session.Api.RoomExistsAsync(code)) { error = "Room not found."; return; }
        await Session.EnsureGuestAsync(Clean());
        Nav.NavigateTo("/room/" + code);
    });

    private async Task GoTo(string code)
    {
        await Run(async () =>
        {
            await Session.EnsureGuestAsync(Clean());
            Nav.NavigateTo("/room/" + code);
        });
    }

    private string Clean() => string.IsNullOrWhiteSpace(name) ? "Guest" : name.Trim();
}
