@page "/"
@implements IDisposable
@inject Session Session
@inject NavigationManager Nav
@inject SettingsService Settings

<HeroBoard />
<main class="home @(Settings.ReduceMotion ? "rm" : "")" @onkeydown="OnKey">
  <header class="home-top rise" style="--i:0">
    <span class="brand-mini" aria-hidden="true">
      <svg viewBox="0 0 64 40"><path d="M6 34V18l8 6 8-14 10 12 10-12 8 14 8-6v16z" /><circle cx="32" cy="6" r="3" /></svg>
    </span>
    <div class="top-tools">
      <button type="button" class="icon-btn" aria-pressed="@(!Settings.Muted ? "true" : "false")" aria-label="Sound"
              title="@(Settings.Muted ? "Sound off" : "Sound on")" @onclick="ToggleSound">
        @if (Settings.Muted)
        {
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="M17 9l5 6M22 9l-5 6" /></svg>
        }
        else
        {
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="M16.5 8.5a5 5 0 0 1 0 7M19.5 5.5a9 9 0 0 1 0 13" /></svg>
        }
      </button>
      <button type="button" class="icon-btn" aria-label="Settings" title="Settings" @onclick="() => settingsOpen = true">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg>
      </button>
    </div>
  </header>

  <div class="home-grid">
    <section class="home-intro" aria-labelledby="home-title">
      <p class="kicker rise" style="--i:1">Multiplayer property tycoon · 2–6 players</p>
      <h1 id="home-title" class="wordmark rise" style="--i:2">Board<b>Empire</b></h1>
      <p class="tagline rise" style="--i:3">Build, trade and bankrupt your friends — right in the browser.</p>

      @if (error != null)
      {
        <p class="home-error" role="alert">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 21h20zM12 10v5M12 18v.01" /></svg>
          <span>@error</span>
        </p>
      }

      <ul class="features rise" style="--i:4" aria-label="Highlights">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 7l9 5 9-5zM3 12l9 5 9-5M3 17l9 5 9-5" /></svg>2D and 3D boards</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3v18M3 12h18" opacity=".5" /></svg>Play with friends online</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="7" width="14" height="12" rx="3" /><path d="M12 3v4M9 12h.01M15 12h.01M9.5 16h5" /></svg>Bots from Easy to Expert</li>
      </ul>

      <div class="theme-row rise" style="--i:5">
        <span class="kicker" aria-hidden="true">Theme</span>
        <ThemeChips />
      </div>
    </section>

    <section class="home-cards" aria-label="Ways to play">
      <div class="name-card glass rise" style="--i:2">
        <label for="player-name" class="kicker">Your name</label>
        <div class="input-wrap">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
          <input id="player-name" @bind="name" @bind:event="oninput" maxlength="20" placeholder="Guest" autocomplete="nickname"
                 spellcheck="false" aria-describedby="name-hint" aria-invalid="@(nameHint.Warn ? "true" : "false")" />
        </div>
        <p id="name-hint" class="field-hint @(nameHint.Warn ? "warn" : "")">@nameHint.Text</p>
      </div>

      <article class="pcard glass cta rise" style="--i:3" aria-labelledby="bots-title">
        <div class="pcard-head">
          <span class="pcard-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="4" /><circle class="pip" cx="8" cy="8" r="1.3" /><circle class="pip" cx="16" cy="8" r="1.3" /><circle class="pip" cx="12" cy="12" r="1.3" /><circle class="pip" cx="8" cy="16" r="1.3" /><circle class="pip" cx="16" cy="16" r="1.3" /></svg>
          </span>
          <div>
            <h2 id="bots-title">Play vs bots</h2>
            <p class="hint">Start instantly against computer players.</p>
          </div>
        </div>
        <div class="pcard-controls">
          <label class="field">
            <span>Bots</span>
            <select @bind="botCount">
              @for (int i = 1; i <= 5; i++) { <option value="@i">@i</option> }
            </select>
          </label>
          <label class="field">
            <span>Level</span>
            <select @bind="botLevel">
              @foreach (var l in Enum.GetNames<BotLevel>()) { <option value="@l">@l</option> }
            </select>
          </label>
        </div>
        <button type="button" class="primary big" disabled="@busy" @onclick="PlayBots">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          Play vs bots
        </button>
      </article>

      <article class="pcard glass rise" style="--i:4" aria-labelledby="online-title">
        <div class="pcard-head">
          <span class="pcard-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
          </span>
          <div>
            <h2 id="online-title">Play online</h2>
            <p class="hint">Find a game or invite friends with a room code.</p>
          </div>
        </div>
        <div class="btn-row">
          <button type="button" class="primary" disabled="@busy" @onclick="Quick">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></svg>
            Quick match
          </button>
          <button type="button" class="ghost" disabled="@busy" @onclick="Create">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            Create room
          </button>
        </div>
        <div class="join-row">
          <label for="join-code" class="sr-only">Room code</label>
          <input id="join-code" class="code-input" @bind="joinCode" @bind:event="oninput" maxlength="8" placeholder="Room code"
                 autocomplete="off" autocapitalize="characters" spellcheck="false" aria-describedby="join-hint"
                 aria-invalid="@(codeHint != null ? "true" : "false")" @onkeydown="JoinKey" />
          <button type="button" class="ghost" disabled="@busy" @onclick="Join">Join</button>
        </div>
        <p id="join-hint" class="field-hint @(codeHint != null ? "warn" : "")">@(codeHint ?? "Got a code from a friend? Enter it here.")</p>
      </article>

      <article class="pcard glass rooms-card rise" style="--i:5" aria-labelledby="rooms-title">
        <div class="pcard-head">
          <span class="pcard-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 21V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16" /><path d="M2 21h20M14 12h.01" /></svg>
          </span>
          <div class="grow">
            <h2 id="rooms-title">Open rooms @if (!loading && roomsError == null) { <span class="count-pill">@rooms.Count</span> }</h2>
            <p class="hint">Public games waiting for players.</p>
          </div>
          <button type="button" class="icon-btn refresh @(loading ? "spin" : "")" aria-label="Refresh rooms" title="Refresh" disabled="@loading" @onclick="Refresh">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" /></svg>
          </button>
        </div>
        <div class="rooms-body" aria-live="polite" aria-busy="@(loading ? "true" : "false")">
          @if (loading && rooms.Count == 0)
          {
            <ul class="rooms" aria-label="Loading rooms">
              @for (int i = 0; i < 2; i++) { <li class="room skeleton"><span></span><span></span></li> }
            </ul>
          }
          else if (roomsError != null)
          {
            <div class="rooms-state bad" role="alert">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 8.8a15 15 0 0 1 20 0M5.3 12.3a10 10 0 0 1 13.4 0M8.7 15.7a5 5 0 0 1 6.6 0M12 19.5h.01M3 3l18 18" /></svg>
              <p>@roomsError</p>
              <button type="button" class="ghost" @onclick="Refresh">Try again</button>
            </div>
          }
          else if (rooms.Count == 0)
          {
            <div class="rooms-state">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M3 9h18M9 21V9" /></svg>
              <p>No open rooms. Create one!</p>
            </div>
          }
          else
          {
            <ul class="rooms">
              @foreach (var r in rooms)
              {
                int max = Math.Max(1, r.MaxPlayers);
                int pct = (int)Math.Round(100.0 * Math.Min(r.Players, max) / max);
                <li class="room">
                  <div class="room-main">
                    <span class="room-name">@r.Name</span>
                    <span class="room-meta">
                      <span class="rtag">@r.Preset</span>
                      @if (!string.IsNullOrEmpty(r.Board)) { <span class="rtag soft">@r.Board.Replace('_', ' ')</span> }
                      <span class="rcode">#@r.Code</span>
                    </span>
                    <span class="seat-bar" role="img" aria-label="@($"{r.Players} of {r.MaxPlayers} seats taken")">
                      <span class="seat-fill" style="width:@(pct)%"></span>
                    </span>
                  </div>
                  <span class="room-seats" aria-hidden="true"><b>@r.Players</b>/@r.MaxPlayers</span>
                  <button type="button" class="primary" aria-label="@($"Join {r.Name}")" disabled="@busy" @onclick="() => GoTo(r.Code)">Join</button>
                </li>
              }
            </ul>
          }
        </div>
      </article>
    </section>
  </div>
</main>
@if (settingsOpen) { <div @onkeydown="OnKey"><SettingsSheet OnClose="() => settingsOpen = false" /></div> }

@code {
    private string name = "";
    private string joinCode = "";
    private string? error;
    private string? roomsError;
    private bool busy;
    private bool loading = true;
    private bool settingsOpen;
    private IReadOnlyList<RoomSummary> rooms = Array.Empty<RoomSummary>();

    private (string Text, bool Warn) nameHint => LobbyText.NameHint(name);
    private string? codeHint => LobbyText.RoomCode(joinCode).Hint;

    protected override Task OnInitializedAsync()
    {
        Settings.Changed += OnSettings;
        return Refresh();
    }

    private void OnSettings() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Settings.Changed -= OnSettings;

    private async Task Refresh()
    {
        loading = true;
        try { rooms = await Session.Api.RoomsAsync(); roomsError = null; }
        catch (ApiException e) { roomsError = e.Message; }
        catch (HttpRequestException) { roomsError = "Can't reach the server."; }
        finally { loading = false; }
    }

    private async Task ToggleSound()
    {
        Settings.Muted = !Settings.Muted;
        await Settings.SaveAsync();
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && settingsOpen) settingsOpen = false;
    }

    private Task JoinKey(KeyboardEventArgs e) => e.Key == "Enter" && !busy ? Join() : Task.CompletedTask;

    private async Task Run(Func<Task> action)
    {
        busy = true;
        error = null;
        try { await action(); }
        catch (ApiException e) { error = e.Message; }
        catch (HttpRequestException) { error = "Can't reach the server."; }
        finally { busy = false; }
    }

    private Task Quick() => Run(async () =>
    {
        await Session.EnsureGuestAsync(Clean());
        string code = await Session.Api.QuickMatchAsync("quick");
        Nav.NavigateTo("/room/" + code);
    });

    private Task Create() => Run(async () =>
    {
        var auth = await Session.EnsureGuestAsync(Clean());
        string code = await Session.Api.CreateRoomAsync(auth.DisplayName + "'s game", "classic", "", 6, true);
        Nav.NavigateTo("/room/" + code);
    });

    private int botCount = 3;
    private string botLevel = nameof(BotLevel.Medium);

    private Task PlayBots() => Run(async () =>
    {
        var auth = await Session.EnsureGuestAsync(Clean());
        string code = await Session.Api.CreateRoomAsync(auth.DisplayName + "'s game", "classic", "", botCount + 1, false);
        Nav.NavigateTo($"/room/{code}?bots={botCount}&level={botLevel}");
    });

    private Task Join() => Run(async () =>
    {
        string code = joinCode.Trim().ToUpperInvariant();
        if (code.Length == 0) { error = "Enter a room code."; return; }
        if (!await Session.Api.RoomExistsAsync(code)) { error = "Room not found."; return; }
        await Session.EnsureGuestAsync(Clean());
        Nav.NavigateTo("/room/" + code);
    });

    private async Task GoTo(string code)
    {
        await Run(async () =>
        {
            await Session.EnsureGuestAsync(Clean());
            Nav.NavigateTo("/room/" + code);
        });
    }

    private string Clean() => string.IsNullOrWhiteSpace(name) ? "Guest" : name.Trim();
}
