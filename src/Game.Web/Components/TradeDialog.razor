@{
    var s = Game.Display!;
    int me = TurnActions.Me(Game.Client.Seats);
    string currency = Game.Board!.Currency;
}
@if (me >= 0)
{
<section class="panel card glass trades" aria-labelledby="trades-title">
  <h3 id="trades-title">Trades</h3>
  @foreach (var t in s.Trades.Where(t => t.To == me))
  {
    <div class="offer-card" style="--o:@t.From">
      <p><span class="pdot" aria-hidden="true"></span><b>@s.Players[t.From].Name</b> offers <b>@Describe(t.Give)</b> for <b>@Describe(t.Receive)</b></p>
      <div class="actions">
        <button class="primary" @onclick="() => Game.Client.SendCommand(new AcceptTradeCommand(me, t.Id))">Accept</button>
        <button class="ghost" @onclick="() => Game.Client.SendCommand(new RejectTradeCommand(me, t.Id))">Reject</button>
      </div>
    </div>
  }
  <div class="trade-form">
    <label class="field" for="trade-partner">Trade with
      <select id="trade-partner" @bind="partner">
        @foreach (var p in s.Players.Where(p => p.Id != me && !p.Bankrupt)) { <option value="@p.Id">@p.Name</option> }
      </select>
    </label>
    <div class="trade-amounts">
      <label class="field" for="trade-give">You give (@currency)
        <input id="trade-give" type="number" inputmode="numeric" @bind="give" min="0" placeholder="0" />
      </label>
      <label class="field" for="trade-receive">You receive (@currency)
        <input id="trade-receive" type="number" inputmode="numeric" @bind="receive" min="0" placeholder="0" />
      </label>
    </div>
    <button class="ghost" @onclick="Offer">Offer trade</button>
  </div>
</section>
}

@code {
    [Parameter, EditorRequired] public GameSession Game { get; set; } = null!;
    /// <summary>Optional initial trade partner seat; -1 picks the first other player.</summary>
    [Parameter] public int Partner { get; set; } = -1;
    private int partner = -1;
    private int give;
    private int receive;

    protected override void OnInitialized() => partner = Partner;

    // Keep the select showing a real choice: default (or fall back) to the first other player still in the game.
    protected override void OnParametersSet()
    {
        var s = Game.Display;
        int me = TurnActions.Me(Game.Client.Seats);
        if (s == null || s.Players.Any(p => p.Id == partner && p.Id != me && !p.Bankrupt)) return;
        partner = s.Players.FirstOrDefault(p => p.Id != me && !p.Bankrupt)?.Id ?? -1;
    }

    private string Describe(TradeSide side)
    {
        var parts = new List<string>();
        if (side.Money > 0) parts.Add(Game.Board!.Currency + side.Money);
        var board = Game.Board;
        foreach (var tile in side.Tiles)
            parts.Add(board != null && tile >= 0 && tile < board.Tiles.Count ? board.Tiles[tile].Name : "tile " + tile);
        if (side.JailCards > 0) parts.Add(side.JailCards + " jail card(s)");
        if (side.Shares.Count > 0 || side.Terms.Count > 0) parts.Add("other terms");
        return parts.Count == 0 ? "nothing" : string.Join(", ", parts);
    }

    private void Offer()
    {
        int me = TurnActions.Me(Game.Client.Seats);
        var s = Game.Display;
        if (me < 0 || s == null) return;
        int to = partner;
        if (!s.Players.Any(p => p.Id == to && p.Id != me && !p.Bankrupt))
            to = s.Players.FirstOrDefault(p => p.Id != me && !p.Bankrupt)?.Id ?? -1;
        if (to < 0) return;
        Game.Client.SendCommand(new CreateTradeCommand(me, to,
            new TradeSide { Money = Math.Max(0, give) }, new TradeSide { Money = Math.Max(0, receive) }));
    }
}
