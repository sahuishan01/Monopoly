@implements IDisposable
@inject SettingsService Settings
@* Theme picker chips: each shows the theme's own colours; picking one applies it live and saves it. *@
<div class="theme-chips" role="radiogroup" aria-label="Theme">
  @foreach (var t in themes)
  {
    bool on = Settings.Theme == t.Id;
    <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" class="tchip @(on ? "on" : "")"
            style="--sw-bg:@t.Bg;--sw-panel:@t.Panel;--sw-accent:@t.Accent;--sw-glow:@t.Glow"
            @onclick="() => Pick(t.Id)">
      <span class="tchip-dot" aria-hidden="true"></span>
      <span>@t.Name</span>
    </button>
  }
</div>

@code {
    // Colours are embedded (ThemeCatalog.Swatches), so the chips are right on a cold load with no fetch.
    private readonly IReadOnlyList<ThemeCatalog.Swatch> themes = ThemeCatalog.Swatches;

    protected override void OnInitialized() => Settings.Changed += OnSettings;

    private async Task Pick(string id)
    {
        await Settings.SetThemeAsync(id);
        await Settings.SaveAsync();
    }

    private void OnSettings() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Settings.Changed -= OnSettings;
}
