@implements IAsyncDisposable
@inject IJSRuntime Js
@inject SettingsService Settings
@inject HttpClient Http

<canvas @ref="canvas" class="board3d"></canvas>

@code {
    [Parameter, EditorRequired] public GameSession Game { get; set; } = null!;
    [Parameter] public EventCallback OnUnavailable { get; set; }
    [Parameter] public EventCallback<int> OnTileClick { get; set; }
    private DotNetObjectReference<Board3D>? self;

    [JSInvokable] public Task TileClicked(int tile) => OnTileClick.InvokeAsync(tile);
    private ElementReference canvas;
    private IJSObjectReference? module;
    private bool ready;
    private bool disposed;
    private GameState? applied;   // Display object last pushed to JS; a replaced snapshot object triggers a re-apply via Changed

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/board3d.js");
            if (disposed) return;
            var themeJson = await FetchTheme();
            if (disposed) return;
            var opts = "{\"theme\":" + (themeJson ?? "null") + ",\"quality\":\"" + (Settings.Quality is "low" or "high" ? Settings.Quality : "auto") + "\",\"reduceMotion\":" + (Settings.ReduceMotion ? "true" : "false") + "}";
            appliedTheme = Settings.Theme; appliedQuality = Settings.Quality; appliedReduce = Settings.ReduceMotion;
            if (disposed) return;
            ready = Game.Board != null && await module.InvokeAsync<bool>("init", canvas, DisplayPayload.Board(Game.Board), self = DotNetObjectReference.Create(this), opts);
            if (disposed)
            {
                if (ready) { try { await module.InvokeVoidAsync("dispose"); } catch { } }
                return;
            }
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or ObjectDisposedException) { ready = false; }
        if (disposed) return;
        if (!ready)
        {
            await OnUnavailable.InvokeAsync();
            return;
        }
        await Push(Game.Display);
        Game.EventPlayed += OnEvent;
        Game.Changed += OnChanged;
        Settings.Changed += OnSettings;
    }

    private string? appliedTheme, appliedQuality;
    private bool appliedReduce;
    private int themeSeq;

    private async Task<string?> FetchTheme()
    {
        try { return await Http.GetStringAsync($"themes/{Settings.Theme}.json"); }
        catch { return null; }
    }

    private async void OnSettings()
    {
        try
        {
            if (!ready || module == null || disposed) return;
            if (Settings.Quality != appliedQuality)
            {
                appliedQuality = Settings.Quality;
                await module.InvokeVoidAsync("setQuality", appliedQuality is "low" or "high" ? appliedQuality : "auto");
            }
            if (Settings.ReduceMotion != appliedReduce)
            {
                appliedReduce = Settings.ReduceMotion;
                await module.InvokeVoidAsync("setReduceMotion", appliedReduce);
            }
            if (Settings.Theme == appliedTheme) return;
            appliedTheme = Settings.Theme;
            var seq = ++themeSeq;
            var json = await FetchTheme();
            if (json != null && !disposed && seq == themeSeq) await module.InvokeVoidAsync("setTheme", json);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) { }
    }

    private async Task Push(GameState? s)
    {
        if (!ready || module == null || s == null) return;
        applied = s;
        await module.InvokeVoidAsync("applyState", DisplayPayload.State(s));
    }

    private async void OnEvent(GameEvent e, GameState after)
    {
        try
        {
            if (!ready || module == null || disposed) return;
            await module.InvokeVoidAsync("playEvent", DisplayPayload.Event(e));
            await Push(after);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) { }
    }

    // Snapshots replace the Display object without raising EventPlayed; re-apply when the reference changed.
    private async void OnChanged()
    {
        try
        {
            if (disposed || Game.Display == null || ReferenceEquals(Game.Display, applied)) return;
            await Push(Game.Display);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        self?.Dispose();
        Game.EventPlayed -= OnEvent;
        Game.Changed -= OnChanged;
        Settings.Changed -= OnSettings;
        if (module != null)
        {
            try { await module.InvokeVoidAsync("dispose"); await module.DisposeAsync(); }
            catch (Exception e) when (e is JSDisconnectedException or JSException) { }
        }
    }
}
